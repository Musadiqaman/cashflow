    "secret": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('hex'))\""
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongoose": "9.11.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.1",
    "mongodb-memory-server-core": "11.3.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
